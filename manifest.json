{
  "manifest_version": 3,
  "name": "Hold Still",
  "version": "1.2.0",
  "description": "Capture a full webpage, the current viewport, or a selected area as a PNG.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "downloads",
    "offscreen",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Hold Still",
    "default_popup": "popup/popup.html"
  },
  "commands": {
    "capture-full-page": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Capture the full page"
    },
    "capture-viewport": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Capture the current viewport"
    },
    "capture-selection": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Capture a selected area"
    }
  }
}
